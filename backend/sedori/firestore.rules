rules_version = '2';
// せどり 利益チェック: Cloud Firestore のセキュリティルール
// - 自分の文書(users/{uid} とその下の ledger)だけ読み書きできる。他人の台帳は誰も読めない。
// - subscription(契約の状態)と paypal の項目は、サーバー(Cloudflare Worker のサービスアカウント)だけが書く。
//   サービスアカウントはルールを通らないので、ここでは利用者からの書き込みを禁止するだけでよい。
// - 台帳の書き込みは有料(無料期間・支払い済みの期間)の間だけ。読む・消すは、解約後もいつでもできる。
// - 帳簿(users/{uid}/books/{種類~行のid})の書き込みは、その機能を使えるプランの間だけ。
//   総合以上: 売上(sale)・経費(exp)・毎月の経費(recur)・取り込みの履歴(batch)・覚えた科目(rule)・売れ残りの目安(stale)・家事按分の初期値(pref)
//   業務: 申告用の数字の設定(tax)・期末の棚卸の数(count)。無料期間中は業務のすべて。プランは Worker が書く subscription.planKey で見る
//   (light_* はライト、business_* は業務、それ以外は総合。assets/sync.js の tierOf と同じ)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function sub(uid) { return userDoc(uid).data.get('subscription', {}); }
    function paid(uid) {
      let s = sub(uid);
      return s.get('status', '') in ['trialing', 'active', 'past_due']
        || (s.get('status', '') == 'canceled' && s.get('paidThrough', timestamp.value(0)) > request.time);
    }
    function planKey(uid) { return sub(uid).get('planKey', ''); }
    function trialing(uid) { return sub(uid).get('status', '') == 'trialing'; }
    function businessTier(uid) { return paid(uid) && (trialing(uid) || planKey(uid).matches('business.*')); }
    function totalTier(uid) { return paid(uid) && (trialing(uid) || !planKey(uid).matches('light.*')); }
    function booksKindOK(uid, kind) {
      return (kind in ['sale', 'exp', 'recur', 'batch', 'rule', 'stale', 'pref'] && totalTier(uid))
        || (kind in ['tax', 'count'] && businessTier(uid));
    }
    // 利用者が書いてよい項目
    function userKeys() { return ['email', 'settings', 'settingsAt', 'createdAt', 'lastLoginAt', 'utmFirst']; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(userKeys());
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userKeys())
        && (!('settings' in request.resource.data) || request.resource.data.settings is map)
        && (!('utmFirst' in request.resource.data) || request.resource.data.utmFirst is map);
      // アカウントの削除は、有料の契約が無い時だけ(解約してから)
      allow delete: if isOwner(uid) && !paid(uid);

      match /ledger/{rowId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && paid(uid)
          && rowId.size() <= 64
          && request.resource.data.keys().hasOnly(['row', 'updatedAt', 'deleted', 'serverAt'])
          && request.resource.data.updatedAt is int
          && request.resource.data.deleted is bool
          && (request.resource.data.row == null || request.resource.data.row is map)
          && request.resource.data.serverAt == request.time;
        allow delete: if isOwner(uid);
      }

      match /books/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && docId.size() <= 160
          && request.resource.data.keys().hasOnly(['kind', 'row', 'updatedAt', 'deleted', 'serverAt'])
          && request.resource.data.kind is string
          && docId.split('~')[0] == request.resource.data.kind
          && booksKindOK(uid, request.resource.data.kind)
          && request.resource.data.updatedAt is int
          && request.resource.data.deleted is bool
          && (request.resource.data.row == null || request.resource.data.row is map)
          && request.resource.data.serverAt == request.time;
        allow delete: if isOwner(uid);
      }
    }

    // 先着100名の残り(誰でも読める・書けるのはサーバーだけ)
    match /public/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // それ以外(paypalSubs など Worker 用の対応表)は利用者からは読み書きできない
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
